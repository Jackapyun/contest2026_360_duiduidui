diff --git a/libs/libc/elf/gnu-elf.ld.in b/libs/libc/elf/gnu-elf.ld.in
index aa97a0f5495..5ba3d6d0e26 100644
--- a/libs/libc/elf/gnu-elf.ld.in
+++ b/libs/libc/elf/gnu-elf.ld.in
@@ -94,6 +94,7 @@ SECTIONS
 #endif
   .data : AT(_eronly) SUBALIGN(SECTIONS_ALIGN)
     {
+      __global_pointer$ = . + 0x800;
       _sdata = . ;
       *(.data)
       *(.data1)
@@ -129,6 +130,7 @@ SECTIONS
   .bss :
     {
       _sbss = . ;
+      __bss_start = . ;
       *(.bss)
       *(.bss.*)
       *(.sbss)
@@ -137,6 +139,7 @@ SECTIONS
       *(COMMON)
       . = ALIGN(SECTIONS_ALIGN);
       _ebss = . ;
+      _end = . ;
 
 #ifdef HEAPSIZE
       _sheap = .;
diff --git a/tools/build.sh b/tools/build.sh
index 8ea9183a33d..bc909303d90 100755
--- a/tools/build.sh
+++ b/tools/build.sh
@@ -132,6 +132,37 @@ function build_board_cmake()
     EXTRA_FLAGS=$(echo "$EXTRA_FLAGS" | sed 's/-Wno-cpp//' | xargs)
   fi
   export VELA_EXTRA_FLAGS="$EXTRA_FLAGS"
+
+  # Custom toolchain (e.g. xPack riscv-none-elf): bypass lunch/m and call
+  # cmake directly with explicit compilers, so host tools are not affected.
+  # 用法：./build.sh <board-config> --cmake -c /path/to/riscv-none-elf-gcc -j8
+  if [ -n "${CUSTOM_COMPILER}" ]; then
+    echo "Custom toolchain: ${CUSTOM_COMPILER}"
+    # NOTE: NuttX arch/risc-v/src/cmake/Toolchain.cmake 用
+    # find_program(riscv-none-elf-gcc) 按 PATH 选择编译器，会覆盖
+    # -DCMAKE_C_COMPILER。因此必须把自定义工具链目录前置到 PATH。
+    export PATH="$(dirname ${CUSTOM_COMPILER}):${PATH}"
+    echo "  cmake -B ${CMAKE_BINARY_DIR} -S ${NUTTXDIR} -DBOARD_CONFIG=${ROOTDIR}/${board_config} ..."
+    if ! cmake -B ${CMAKE_BINARY_DIR} -S ${NUTTXDIR} \
+        -DBOARD_CONFIG="${ROOTDIR}/${board_config}" \
+        -DCUSTOM_MODULE_PATH="${ROOTDIR}/build/cmake" \
+        -DCMAKE_C_COMPILER="${CUSTOM_COMPILER}" \
+        -DCMAKE_ASM_COMPILER="${CUSTOM_COMPILER}" \
+        -DEXTRA_FLAGS="${EXTRA_FLAGS}" ${CMAKE_GENERATOR}; then
+      echo "Error: ############# config ${1} fail ##############"
+      exit 1
+    fi
+    j_arg=$(echo ${@:2} | grep -oP '\-j[0-9]+')
+    if [ -z "$j_arg" ]; then
+      j_arg="-j8"
+    fi
+    if ! ninja -C ${CMAKE_BINARY_DIR} $j_arg; then
+      echo "Error: ############# build ${1} fail ##############"
+      exit 2
+    fi
+    return 0
+  fi
+
   # let use lunch directily
   echo " lunch $1 ${CMAKE_BINARY_DIR} "
   lunch $1 ${CMAKE_BINARY_DIR}
@@ -280,4 +311,3 @@ if [ -z "$CMAKE_BUILD" ]; then
 else
   build_board_cmake ${board_config} $*
 fi
