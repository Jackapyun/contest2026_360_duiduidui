# SpaceMiT MUSE Pi Pro - RCPU (N308) NSH 最小体积版
# 基线: configs/nsh/defconfig（全功能验证版 206KB）
# 目标: 固件 < 256KB 且堆余量 > 100KB（256KB SRAM 硬预算）
# 裁剪:
#   - 移除测试组件 ostest/mm/getprime/hello
#   - 关闭断言/backtrace/栈染色/dumpstack/调试日志字符串
#   - 关闭 libm 与 strerror 全表
#   - 关闭 builtin/符号表/readline 历史
#   - 禁用部分 NSH 命令
# 保留: DEBUG_FULLOPT(-Os)、procfs（调试价值高）、FPU
CONFIG_ARCH="risc-v"
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_CHIP="k1-rcpu"
CONFIG_ARCH_CHIP_K1_RCPU=y
CONFIG_ARCH_CHIP_RISCV_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/SpaceMiT/chips/k1-rcpu"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="k1-rcpu"
CONFIG_ARCH_BOARD="muse_pi_pro_rcpu"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/SpaceMiT/boards/k1-rcpu/muse_pi_pro_rcpu"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="muse_pi_pro_rcpu"
CONFIG_ARCH_BOARD_MUSE_PI_PRO_RCPU=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_SYMBOLS_LEVEL="-g"
CONFIG_BOARD_LOOPSPERMSEC=131
CONFIG_DEV_ZERO=y
CONFIG_DEV_NULL=y
CONFIG_FILE_STREAM=y
CONFIG_FS_PROCFS=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=3072
CONFIG_LIBC_ENVPATH=y
CONFIG_LIBC_PERROR_STDOUT=y
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=6
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_RAM_SIZE=262144
CONFIG_RAM_START=0x0
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SERIAL_UART_ARCH_MMIO=y
CONFIG_START_DAY=13
CONFIG_START_MONTH=8
CONFIG_START_YEAR=2026
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_STACKSIZE=3072
CONFIG_USEC_PER_TICK=1000
# RCPU UART0: PXA variant (ns16550 + UUE) @0xC0881000, ECLIC ID 63 -> IRQ 79
CONFIG_16550_ADDRWIDTH=0
CONFIG_16550_REGINCR=4
CONFIG_16550_UART=y
CONFIG_16550_UART0=y
CONFIG_16550_UART0_BASE=0xc0881000
CONFIG_16550_UART0_CLOCK=25600000
CONFIG_16550_UART0_IRQ=79
CONFIG_16550_UART0_SERIAL_CONSOLE=y
