# SpaceMiT MUSE Pi Pro - RCPU (Nuclei N308) NSH PROTECTED (kernel M-mode + user U-mode)
# derived from configs/nsh (FLAT) + PROTECTED 内存管理配置（见 design doc §1.6）
# - MPU = N308 8x TOR PMP, kernel protected from user
# - RAM = DDR remap window 0x30000000 (2MB), kernel at base, user blob at CONFIG_NUTTX_USERSPACE
# - kernel heap via CONFIG_MM_KERNEL_HEAPSIZE (M-only); user heap from us_bssend->us_heapend
# - syscalls: ECALLU (CONFIG_LIB_SYSCALL auto-selected by BUILD_PROTECTED)
CONFIG_ARCH="risc-v"
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_CHIP="k1-rcpu"
CONFIG_ARCH_CHIP_K1_RCPU=y
CONFIG_ARCH_CHIP_RISCV_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/SpaceMiT/chips/k1-rcpu"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="k1-rcpu"
CONFIG_ARCH_BOARD="muse_pi_pro_rcpu"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/SpaceMiT/boards/k1-rcpu/muse_pi_pro_rcpu"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="muse_pi_pro_rcpu"
CONFIG_ARCH_BOARD_MUSE_PI_PRO_RCPU=y
CONFIG_ARCH_INTERRUPTSTACK=8192
CONFIG_ARCH_KERNEL_STACK=y
CONFIG_ARCH_KERNEL_STACKSIZE=4096
CONFIG_ARCH_USE_MPU=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_STACK_COLORATION=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_BOARD_LOOPSPERMSEC=131
CONFIG_BUILD_PROTECTED=y
CONFIG_BUILTIN=y
CONFIG_DEV_ZERO=y
CONFIG_DEV_NULL=y
CONFIG_EXAMPLES_HELLO=y
CONFIG_FILE_STREAM=y
CONFIG_FS_PROCFS=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=3072
CONFIG_LIBC_ENVPATH=y
CONFIG_LIBC_PERROR_STDOUT=y
CONFIG_LIBC_STRERROR=y
CONFIG_LIBM=y
CONFIG_MM_KERNEL_HEAPSIZE=131072
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=6
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_NUTTX_USERSPACE=0x30080000
CONFIG_RAM_SIZE=2097152
CONFIG_RAM_START=0x30000000
CONFIG_READLINE_CMD_HISTORY=y
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SERIAL_UART_ARCH_MMIO=y
CONFIG_START_DAY=12
CONFIG_START_MONTH=8
CONFIG_START_YEAR=2026
CONFIG_SYMTAB_ORDEREDBYNAME=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_STACKSIZE=3072
CONFIG_TESTING_GETPRIME=y
CONFIG_TESTING_OSTEST=y
CONFIG_USEC_PER_TICK=1000
# RCPU UART0: PXA variant @0xC0881000 (自研驱动 k1r_serial.c)
CONFIG_K1R_UART=y
CONFIG_K1R_UART0_BAUD=115200
CONFIG_K1R_UART0_CLOCK=24000000
CONFIG_K1R_UART0_SERIAL_CONSOLE=y
# debug
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_SCHED_CPULOAD=y
CONFIG_SYSLOG_COLOR_OUTPUT=y
CONFIG_SYSTEM_DUMPSTACK=y
CONFIG_TESTING_MM=y
CONFIG_TIMER=y
