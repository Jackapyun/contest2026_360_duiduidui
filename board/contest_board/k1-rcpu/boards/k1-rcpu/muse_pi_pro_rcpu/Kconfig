config ARCH_BOARD_MUSE_PI_PRO_RCPU
	bool "SpacemiT MUSE Pi Pro - RCPU (N308)"
	---help---
		SpacemiT MUSE Pi Pro 的 RCPU（Nuclei N308，RV32 M-Mode 单核）
		板级。控制台：RCPU UART0 @0xC0881000（PXA 变体，GPIO47/48
		MUX_MODE1）。固件由 AP 侧 remoteproc 加载或 JTAG 加载到 SRAM。

if ARCH_BOARD_MUSE_PI_PRO_RCPU

choice
	prompt "MUSE Pi Pro RCPU Target Selection"
	default MUSE_PI_PRO_RCPU_NSH

config MUSE_PI_PRO_RCPU_NSH
	bool "NSH (flat build)"

endchoice

endif
